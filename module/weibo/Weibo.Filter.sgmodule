#!name=Weibo International Filter
#!desc=基于微博国际版 2026-09-01 抓包过滤广告、热搜、搜索红包、正文推荐词、评论搜索高亮和 URL 跟踪参数，并提供用户身份、来源点击等字段开关。
#!system=ios
#!arguments=脚本地址:https://raw.githubusercontent.com/giveup/sg-mod/main/scripts/weibo/response.bundle.js,过滤广告:true,隐藏会员横幅:true,隐藏热搜:true,隐藏图片搜索红包:true,隐藏正文推荐词:true,移除评论搜索高亮:true,清理URL跟踪参数:true,覆盖用户身份字段:true,启用来源点击:true,会员字段覆盖:false,网络配置覆盖:false,旧版卡片状态覆盖:false,拦截广告与上报:true
#!arguments-desc=广告、热搜、图片搜索红包、正文“大家都在搜”、评论搜索高亮、URL 归因参数、users/show 身份字段及 feed 来源点击默认处理；会员、网络和旧版卡片状态覆盖默认关闭。所有赋值行为均有独立开关。

[Map Local]
^h(?=[{{{拦截广告与上报}}}])ttps:\/\/api\.weibo\.cn\/2\/ad\/(?:[^?]*)(?:\?|$) data="{\"data\":[],\"errno\":0,\"error\":\"\"}" data-type=text status-code=200 header="Content-Type:application/json; charset=utf-8"
^h(?=[{{{隐藏热搜}}}])ttps:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?(?:[^#]*&)?a=search_topic(?:&|$) data="{\"data\":[],\"info\":\"\",\"retcode\":0,\"ext\":{\"search_hot_simple\":{\"title\":\"\",\"desc\":\"\",\"more\":\"\"},\"search_hot\":{\"title\":\"\",\"desc\":\"\",\"more\":\"\"},\"search_city\":{\"title\":\"\",\"desc\":\"\",\"more\":\"\"}}}" data-type=text status-code=200 header="Content-Type:application/json; charset=utf-8"

[URL Rewrite]
^h(?=[{{{拦截广告与上报}}}])ttps:\/\/api\.weibo\.cn\/2\/(?:logservice\/|sdk\/union_config(?:\?|$)) - reject
^h(?=[{{{拦截广告与上报}}}])ttps:\/\/(?:bootpreload|bootrealtime)\.uve\.weibo\.com\/ - reject
^h(?=[{{{拦截广告与上报}}}])ttps:\/\/tqt\.weibo\.cn\/ - reject

[Script]
Weibo.JSON.Filter = type=http-response,pattern=^https:\/\/(?:api\.weibo\.cn\/2\/(?:ad\/[^?]*|account\/login|comments\/build_comments|photo\/info|profile(?:\/statuses\/(?:tab|timefilter))?|users\/show|cardlist|favorites|statuses\/(?:container_detail|container_timeline_hot|container_timeline_topic|friends\/timeline|longtext_show_batch|mentions|show))|weibointl\.api\.weibo\.cn\/portal\.php)(?:\?|$),requires-body=1,max-size=-1,engine=webview,timeout=30,script-path={{{脚本地址}}}?v=af47d5b1,argument="{\"blockAds\":{{{过滤广告}}},\"blockVipBanner\":{{{隐藏会员横幅}}},\"disableHotSearch\":{{{隐藏热搜}}},\"disablePhotoSearchRedPacket\":{{{隐藏图片搜索红包}}},\"blockPostTrendingSearches\":{{{隐藏正文推荐词}}},\"removeCommentSearchHighlights\":{{{移除评论搜索高亮}}},\"stripTrackingParameters\":{{{清理URL跟踪参数}}},\"applyUserIdentityConfig\":{{{覆盖用户身份字段}}},\"enableFeedSourceLinks\":{{{启用来源点击}}},\"applyMembershipConfig\":{{{会员字段覆盖}}},\"applyNetworkTuning\":{{{网络配置覆盖}}},\"applyLegacyCardStatus\":{{{旧版卡片状态覆盖}}}}"

[MITM]
hostname = %APPEND% api.weibo.cn, weibointl.api.weibo.cn, bootpreload.uve.weibo.com, bootrealtime.uve.weibo.com, tqt.weibo.cn
